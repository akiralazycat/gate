{
  "name": "gate",
  "version": "0.2.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run build:package && next dev",
    "build": "npm run build:package && next build",
    "build:package": "npm --prefix packages/gate run build",
    "start": "next start",
    "typecheck": "npm run build:package && tsc --noEmit"
  },
  "dependencies": {
    "@akiralazycat/gate": "*",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
