{
  "name": "gate",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run build:package && next dev",
    "build": "npm run build:package && next build",
    "build:package": "npm --prefix packages/gate run build",
    "test:package": "npm run build:package && node scripts/smoke-package.mjs",
    "test:security": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/smoke-security.mjs",
    "firewall:stage": "bash scripts/firewall-stage.sh",
    "firewall:diff": "vercel firewall diff",
    "start": "next start",
    "typecheck": "npm run build:package && tsc --noEmit",
    "verify": "npm run typecheck && npm run test:package && npm run test:security && npm run build"
  },
  "dependencies": {
    "@akiralazycat/gate": "*",
    "@upstash/redis": "1.38.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "engines": { "node": ">=22" }
}
