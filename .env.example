# Required: the credential visitors enter at the Gate.
# Vault mode works best with a numeric 4-8 digit value.
GATE_PASSWORD=0427

# Required: long random secret used only to sign the session cookie.
# Example generation: openssl rand -base64 32
GATE_SECRET=replace-with-a-long-random-secret

# Optional UI mode: vault | cipher | classic
GATE_MODE=vault

# Optional. Used by Classic mode. Defaults to guest.
GATE_USERNAME=guest

# Optional presentation settings
GATE_NAME=Private Archive
GATE_MESSAGE=Authorized access only
GATE_ALLOW_STYLE_SWITCH=true
GATE_PIN_LENGTH=4

# Optional session lifetime, in seconds. Defaults to 43200 (12 hours).
GATE_SESSION_TTL=43200
