# Required: the static credential visitors enter at the Gate.
# Vault mode works best with a numeric 6-8 digit value when access codes are enabled.
GATE_PASSWORD=042731

# Required: long random secret used only to sign the session cookie.
# Example generation: openssl rand -base64 32
GATE_SECRET=replace-with-a-long-random-secret

# Optional during a signing-key rotation. Remove after the longest prior session expires.
GATE_SECRET_PREVIOUS=

# UI/auth policy: vault | cipher | classic
GATE_MODE=vault

# Used by Classic mode. Defaults to guest.
GATE_USERNAME=guest

# Presentation
GATE_NAME=Private Archive
GATE_MESSAGE=Authorized access only
# Applies to Vault policy. Cipher and Classic keep their required native inputs.
GATE_ALLOW_STYLE_SWITCH=true
GATE_PIN_LENGTH=6
GATE_THEME_PRESET=nocturne

# Optional JSON override. gate.theme.json is used when this is empty.
# GATE_THEME_JSON={"version":1,...}

# Session lifetime, seconds. Defaults to 43200 (12 hours).
GATE_SESSION_TTL=43200

# Application-level abuse limits per client address. Successful authenticated
# requests reset their counter. Redis is used when configured; otherwise Gate
# keeps a bounded process-local safety net. Keep the Vercel Firewall in front.
GATE_UNLOCK_RATE_LIMIT=10
GATE_UNLOCK_RATE_WINDOW=60
GATE_ADMIN_RATE_LIMIT=6
GATE_ADMIN_RATE_WINDOW=60

# Optional: expose non-secret readiness check names in production health output.
GATE_HEALTH_DETAILS=false

# Expiring / one-time access codes
GATE_ACCESS_CODES=false
# Required to issue codes through POST /api/gate/codes
GATE_ADMIN_TOKEN=replace-with-a-separate-long-random-admin-token
GATE_CODE_PREFIX=gate:code:

# Production code storage. Provision Upstash Redis through the Vercel Marketplace.
# Local development falls back to an in-memory store; production never does.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
